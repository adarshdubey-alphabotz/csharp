<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_buddy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD1E293B"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_buddy_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pikachu"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_buddy_emotion"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/buddy_emotion_happy" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_buddy_berry_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/buddy_berry" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_buddy_candy_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Candy: 0.7 / 1.0 km"
                android:textColor="#FACC15"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_buddy_hunger_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="85" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_buddy_hearts_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Hearts today: 5 / 8"
        android:textColor="#94A3B8"
        android:textSize="11sp" />
</LinearLayout>
